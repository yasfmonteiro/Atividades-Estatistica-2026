    {
      "cell_type": "markdown",
      "source": [
        "4- Para uma amostra que apresenta 15 °Brix, qual seria a quantidade de açúcar\n",
        "esperada?\n"
      ],
      "metadata": {
        "id": "Q7KtlmsePQte"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "3cf1adbd",
        "outputId": "39943f17-f478-4d9a-9e0c-3e0005e51b4a"
      },
      "source": [
        "from sklearn.linear_model import LinearRegression\n",
        "import numpy as np\n",
        "\n",
        "# Definir as variáveis independentes (X) e dependentes (y)\n",
        "X = df[['Solidos_Soluveis_Brix']]\n",
        "y = df['Acucar_g_100g']\n",
        "\n",
        "# Criar e treinar o modelo de regressão linear\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "# Valor de °Brix para prever\n",
        "brix_to_predict = np.array([[15]])\n",
        "\n",
        "# Fazer a previsão\n",
        "sugar_predicted = model.predict(brix_to_predict)\n",
        "\n",
        "print(f\"Para uma amostra com 15 °Brix, a quantidade de açúcar esperada é de aproximadamente {sugar_predicted[0]:.2f} g/100g.\")"
      ],
      "execution_count": 8,
