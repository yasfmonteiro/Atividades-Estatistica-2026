        "id": "ded060a6",
        "outputId": "cf7f5888-57b2-4590-921f-f8815c268e2e"
      },
      "source": [
        "# Calculate the Pearson correlation coefficient between °Brix and sugar content\n",
        "correlation = df['Solidos_Soluveis_Brix'].corr(df['Acucar_g_100g'])\n",
        "\n",
        "print(f\"A correlação de Pearson entre °Brix e a quantidade de açúcar é: {correlation:.4f}\")"
      ],
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "A correlação de Pearson entre °Brix e a quantidade de açúcar é: 0.9522\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 696
        },
        "id": "74360dd4",
        "outputId": "099be143-1398-4e9a-8590-6bbbc60c94c8"
      },
      "source": [
        "# Group data by 'Categoria' and calculate the mean for Brix and Sugar\n",
        "category_means = df.groupby('Categoria')[['Solidos_Soluveis_Brix', 'Acucar_g_100g']].mean().reset_index()\n",
        "\n",
        "# Melt the DataFrame for easier plotting with seaborn\n",
        "category_melted = category_means.melt(id_vars='Categoria', var_name='Medida', value_name='Valor Médio')\n",
        "\n",
        "# Create a grouped bar chart\n",
        "plt.figure(figsize=(12, 7))\n",
        "sns.barplot(x='Categoria', y='Valor Médio', hue='Medida', data=category_melted, palette='viridis')\n",
        "plt.title('Comparação do Teor Médio de °Brix e Açúcar por Categoria')\n",
        "plt.xlabel('Categoria')\n",
        "plt.ylabel('Valor Médio')\n",
        "plt.xticks(rotation=45, ha='right')\n",
        "plt.legend(title='Medida')\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.show()"
