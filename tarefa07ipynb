      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Identify the columns for soluble solids (Brix) and sugar content\n",
        "# Based on the dataframe information, the correct column names are:\n",
        "brix_col = 'Solidos_Soluveis_Brix'\n",
        "sugar_col = 'Acucar_g_100g'\n",
        "\n",
        "# Create a scatter plot to visualize the relationship with a regression line\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.regplot(x=df[brix_col], y=df[sugar_col], scatter_kws={'alpha':0.6}, line_kws={'color':'red'})\n",
        "plt.title(f'Relação entre {brix_col} e {sugar_col} com Linha de Regressão')\n",
        "plt.xlabel(f'{brix_col} (°Brix)')\n",
        "plt.ylabel(f'{sugar_col} (quantidade)')\n",
        "plt.grid(True)\n",
        "plt.show()"
